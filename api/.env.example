# ---- Где слушать ----
# 127.0.0.1 — API доступен только через nginx (рекомендуется).
HOST=127.0.0.1
PORT=8787
# Стоит за nginx — брать IP клиента из X-Forwarded-For (для лимита попыток входа).
TRUST_PROXY=1

# ---- MySQL из Pterodactyl ----
# Панель → сервер → Databases → New Database. Оттуда берутся Endpoint,
# Username и Password. Если API запущен на том же VDS — хост 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=s1_solanveyr
DB_USER=u1_xxxxxxxxxx
DB_PASSWORD=пароль_из_панели

# ---- Доступ сайта ----
# С каких адресов сайт может обращаться к API (через запятую, без / в конце).
ALLOWED_ORIGINS=https://solanveyr.com,https://www.solanveyr.com,https://10kara.github.io,http://localhost:5173

# ---- Админ-панель ----
ADMIN_USER=tenkara
# Обе строки ниже генерирует: node hash-password.js "ваш-пароль"
ADMIN_PASSWORD_HASH=
TOKEN_SECRET=
TOKEN_TTL_DAYS=7

# ---- Изображения ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
